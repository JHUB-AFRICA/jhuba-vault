generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  fullName         String
  email            String         @unique
  passwordHash     String
  phoneNumber      String
  identificationId String         @unique
  department       String?
  bio              String?
  githubUrl        String?
  avatarUrl        String?
  avatarPublicId   String?
  role             Role           @default(INNOVATOR)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  requests         AssetRequest[]
  auditLogs        AuditLog[]
  supportProjects   SupportProject[] @relation("SupportProjectInnovator")
  supportRequests   SupportRequest[] @relation("SupportRequester")
  supportAssignments SupportRequest[] @relation("SupportAssignee")
  supportUpdates    SupportUpdate[]  @relation("SupportUpdateAuthor")
}

model Asset {
  id             String        @id @default(uuid())
  assetTag       String        @unique
  name           String
  category       AssetCategory
  description    String
  totalQuantity  Int           @default(1)
  availableQty   Int           @default(1)
  imageUrl       String?
  imagePublicId  String?
  specifications Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  price          Decimal       @default(0) @db.Decimal(12, 2)
  requestItems   RequestItem[]
}

model AssetRequest {
  id              String        @id @default(uuid())
  projectName     String
  projectAbstract String
  loanDays        Int
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  startDate       DateTime
  expectedReturn  DateTime
  actualReturn    DateTime?
  innovatorId     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  innovator       User          @relation(fields: [innovatorId], references: [id], onDelete: Restrict)
  requestItems    RequestItem[]
  teamMembers     TeamMember[]

  @@index([innovatorId, status])
}

model TeamMember {
  id            String       @id @default(uuid())
  fullName      String
  email         String
  phoneNumber   String
  studentOrIdNo String
  roleInProject String
  requestId     String
  request       AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model RequestItem {
  id        String       @id @default(uuid())
  quantity  Int
  requestId String
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  request   AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, assetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model SupportRequest {
  id              String           @id @default(uuid())
  reference       String
  title           String
  description     String           @db.Text
  category        SupportCategory
  priority        SupportPriority  @default(NORMAL)
  status          SupportStatus    @default(SUBMITTED)
  details         Json
  projectId       String
  requesterId     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignedToId    String?
  declineReason   String?
  deferReason     String?
  deliverySummary String?          @db.Text
  actualOutcome   String?          @db.Text
  completedAt     DateTime?
  closedAt        DateTime?
  evidenceLinks   Json?
  project         SupportProject  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requester       User             @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedTo      User?            @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  updates         SupportUpdate[]
  feedback        SupportFeedback[]
}

model SupportProject {
  id          String          @id @default(uuid())
  name        String
  status      SupportProjectStatus @default(ACTIVE)
  innovatorId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  innovator   User            @relation("SupportProjectInnovator", fields: [innovatorId], references: [id], onDelete: Cascade)
  requests    SupportRequest[]
}

model SupportUpdate {
  id         String                 @id @default(uuid())
  requestId  String
  authorId   String
  body       String                 @db.Text
  visibility SupportUpdateVisibility @default(REQUESTER)
  kind       SupportUpdateKind      @default(COMMENT)
  createdAt  DateTime               @default(now())
  request    SupportRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author     User                   @relation("SupportUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
}

model SupportFeedback {
  id        String         @id @default(uuid())
  requestId String
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

enum Role {
  INNOVATOR
  ADMIN
}

enum AssetCategory {
  COMPUTING_PERIPHERALS
  NETWORKING_INFRASTRUCTURE
  IOT_PROTOTYPING
  AV_PRESENTATION
  OFFICE_SUPPLIES
  FURNITURE
  SOFTWARE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHECKED_OUT
  RETURNED
  OVERDUE
}

enum SupportCategory {
  COMPUTE_AI
  DATA_RESEARCH
  MENTORSHIP @map("MENTORSHIP_DOMAIN_EXPERTISE")
  FIELD_VALIDATION
  TECHNICAL_DEVELOPMENT
  PRODUCT_BUSINESS @map("PRODUCT_BUSINESS_SUPPORT")
  @@map("SupportCategory")
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  @@map("SupportPriority")
}

enum SupportStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  DECLINED
  DEFERRED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  @@map("SupportRequestStatus")
}

enum SupportProjectStatus {
  ACTIVE
  ARCHIVED
  @@map("ProjectStatus")
}

enum SupportUpdateVisibility {
  REQUESTER
  INTERNAL
  @@map("SupportUpdateVisibility")
}

enum SupportUpdateKind {
  COMMENT
  CLARIFICATION_REQUEST
  CLARIFICATION_RESPONSE
  STATUS_CHANGE
  @@map("SupportUpdateKind")
}
